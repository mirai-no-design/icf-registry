{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icfhub:schema/mapping",
  "title": "Mapping",
  "type": "object",
  "required": [
    "id",
    "source_system",
    "source_code",
    "target_concept",
    "relation",
    "evidence",
    "status",
    "since"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "status": {
      "enum": [
        "active",
        "deprecated"
      ]
    },
    "since": {
      "type": "string"
    },
    "deprecated": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "source_system": {
      "type": "string"
    },
    "source_code": {
      "type": "string"
    },
    "target_concept": {
      "type": "string"
    },
    "relation": {
      "enum": [
        "exact",
        "broader",
        "narrower",
        "related"
      ]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "evidence": {
      "type": "string"
    }
  }
}